<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Mis pedidos</h1>
  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold">Pedido #<%= order.id %></span>
            <span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded-full"><%= order.status.humanize %></span>
          </div>
          <div class="flex justify-between items-center text-sm text-gray-600">
            <span><%= order.created_at.strftime("%d/%m/%Y") %></span>
            <div class="flex items-center gap-4">
              <span class="font-bold text-gray-900">$<%= number_with_delimiter(order.total) %></span>
              <%= link_to "Ver →", order_path(order), class: "text-indigo-600 font-medium" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <p class="text-5xl mb-4">📦</p>
      <p class="text-gray-600 mb-4">Todavía no tenés pedidos.</p>
      <%= link_to "Empezar a comprar", products_path, class: "bg-indigo-600 text-white px-6 py-2 rounded-xl text-sm font-medium" %>
    </div>
  <% end %>
</div>