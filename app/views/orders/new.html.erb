<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Finalizar compra</h1>
  <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
    <div class="md:col-span-3">
      <%= form_with model: @order, url: orders_path, local: true do |f| %>
        <div class="bg-white rounded-xl border border-gray-200 p-6 mb-4">
          <h2 class="font-semibold mb-4">Datos de envío</h2>
          <div class="mb-4">
            <%= f.label :shipping_address, "Dirección", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :shipping_address, rows: 3,
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
                placeholder: "Calle, número, ciudad..." %>
          </div>
          <div>
            <%= f.label :notes, "Notas (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :notes, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>
        <%= f.submit "Confirmar pedido →", class: "w-full bg-indigo-600 text-white py-3 rounded-xl font-semibold hover:bg-indigo-700 cursor-pointer" %>
      <% end %>
    </div>
    <div class="md:col-span-2">
      <div class="bg-white rounded-xl border border-gray-200 p-5 sticky top-20">
        <h3 class="font-semibold mb-4">Resumen</h3>
        <% total = 0 %>
        <% (session[:cart] || {}).each do |id, qty| %>
          <% next unless (p = Product.find_by(id: id)) %>
          <% sub = p.price * qty.to_i; total += sub %>
          <div class="flex justify-between text-sm mb-2">
            <span class="text-gray-600 truncate mr-2"><%= p.name %> ×<%= qty %></span>
            <span class="font-medium shrink-0">$<%= number_with_delimiter(sub) %></span>
          </div>
        <% end %>
        <div class="border-t pt-3 mt-3 flex justify-between font-bold">
          <span>Total</span>
          <span class="text-indigo-600">$<%= number_with_delimiter(total) %></span>
        </div>
      </div>
    </div>
  </div>
</div>