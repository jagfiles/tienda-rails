<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row gap-8">
    <aside class="w-full md:w-56 shrink-0">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="font-semibold mb-4">Filtros</h3>
        <%= form_with url: products_path, method: :get, local: true do |f| %>
          <%= f.text_field :search, value: params[:search], placeholder: "Buscar...", class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm mb-4 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          <%= link_to "Todas", products_path, class: "block text-sm py-1 #{params[:category].blank? ? 'text-indigo-600 font-medium' : 'text-gray-600'}" %>
          <% @categories.each do |cat| %>
            <%= link_to cat.name, products_path(category: cat.slug), class: "block text-sm py-1 #{params[:category] == cat.slug ? 'text-indigo-600 font-medium' : 'text-gray-600'}" %>
          <% end %>
          <%= f.hidden_field :category, value: params[:category] %>
          <%= f.submit "Buscar", class: "w-full mt-4 bg-indigo-600 text-white py-2 rounded-lg text-sm font-medium cursor-pointer hover:bg-indigo-700" %>
        <% end %>
      </div>
    </aside>
    <div class="flex-1">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Productos</h1>
        <span class="text-sm text-gray-500"><%= @products.total_count %> productos</span>
      </div>
      <% if @products.any? %>
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">
          <% @products.each do |p| %>
            <div class="bg-white rounded-xl border border-gray-200 hover:shadow-lg transition-all overflow-hidden">
              <%= link_to product_path(p) do %>
                <div class="aspect-square bg-gray-100 flex items-center justify-center">
                  <span class="text-5xl text-gray-300">🛍️</span>
                </div>
              <% end %>
              <div class="p-4">
                <p class="text-xs text-indigo-600 mb-1"><%= p.category.name %></p>
                <%= link_to p.name, product_path(p), class: "text-sm font-semibold text-gray-900 hover:text-indigo-600 block mb-2 line-clamp-2" %>
                <div class="flex items-center justify-between">
                  <span class="font-bold">$<%= number_with_delimiter(p.price) %></span>
                  <% if p.available? %>
                    <%= button_to "Agregar", add_cart_path(product_id: p.id), method: :post, class: "bg-indigo-600 text-white text-xs px-3 py-1.5 rounded-lg hover:bg-indigo-700" %>
                  <% else %>
                    <span class="text-xs text-gray-400 bg-gray-100 px-3 py-1.5 rounded-lg">Sin stock</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div class="mt-8 flex justify-center gap-2 text-sm">
          <%= link_to_prev_page @products, "← Anterior", class: "px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" %>
          <span class="px-4 py-2 text-gray-500">Página <%= @products.current_page %> / <%= @products.total_pages %></span>
          <%= link_to_next_page @products, "Siguiente →", class: "px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" %>
        </div>
      <% else %>
        <div class="text-center py-16 text-gray-400">
          <p class="text-4xl mb-4">🔍</p>
          <p>No se encontraron productos.</p>
          <%= link_to "Ver todos", products_path, class: "mt-2 text-indigo-600 text-sm inline-block" %>
        </div>
      <% end %>
    </div>
  </div>
</div>